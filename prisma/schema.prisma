generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  IPO_MANAGER
  COMPLIANCE_OFFICER
  FINANCE_OFFICER
  CUSTOMER_SUPPORT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  VERIFYING
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_SUBMITTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  REFERRAL_COMMISSION
  BONUS
  INVESTMENT
  PROFIT
  IPO_SUBSCRIPTION
  IPO_REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  PROCESSING
  REJECTED
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Currency {
  USDT_TRC20
  BTC
  ETH
  BANK
}

enum PaymentProvider {
  PAYSTACK
  MPESA
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum IpoStatus {
  DRAFT
  UPCOMING
  OPEN
  CLOSING_SOON
  CLOSED
  ALLOCATION_PENDING
  ALLOCATION_COMPLETED
  LISTED
  COMPLETED
}

enum IpoApplicationStatus {
  SUBMITTED
  PAYMENT_PENDING
  PAID
  UNDER_REVIEW
  SUBMITTED_TO_ISSUER
  ALLOCATED
  PARTIALLY_ALLOCATED
  NOT_ALLOCATED
  REFUND_PENDING
  REFUNDED
  COMPLETED
}

enum IpoRefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum IpoDocumentType {
  PROSPECTUS
  FINANCIALS
  UPLOAD
  NOTICE
  RESULT
}

model User {
  id                    String                   @id @default(cuid())
  email                 String                   @unique
  username              String                   @unique
  passwordHash          String
  firstName             String?
  lastName              String?
  phone                 String?
  country               String?
  avatarUrl             String?
  role                  Role                     @default(USER)
  status                AccountStatus            @default(ACTIVE)
  kycStatus             KycStatus                @default(NOT_SUBMITTED)
  kycDocuments          KycDocument[]
  twoFactor             Boolean                  @default(false)
  twoFactorSecret       String?
  emailVerified         Boolean                  @default(false)
  referralCode          String                   @unique
  referredById          String?
  referredBy            User?                    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             User[]                   @relation("Referrals")
  walletBalance         Float                    @default(0)
  profitBalance         Float                    @default(0)
  totalDeposited        Float                    @default(0)
  totalWithdrawn        Float                    @default(0)
  totalInvested         Float                    @default(0)
  totalReferralEarnings Float                    @default(0)
  notifications         Notification[]
  transactions          Transaction[]
  investments           Investment[]
  withdrawals           Withdrawal[]
  depositRequests       DepositRequest[]
  payments              Payment[]
  wallets               Wallet[]
  auditLogs             AuditLog[]
  loginAttempts         LoginAttempt[]
  passwordReset         PasswordResetToken[]
  verificationTokens    EmailVerificationToken[]
  refreshTokens         RefreshToken[]
  tickets               Ticket[]
  ticketMessages        TicketMessage[]
  activities            Activity[]
  ipoApplications       IpoApplication[]         @relation("IpoApplications")
  ipoInvestorProfile    IpoInvestorProfile?
  ipoRefunds            IpoRefund[]              @relation("IpoRefunds")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([referredById])
  @@index([role])
  @@index([createdAt])
}

model KycDocument {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  documentUrl String
  status      KycStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model InvestmentPlan {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  description  String
  minAmount    Float
  maxAmount    Float
  dailyReturn  Float
  durationDays Int
  totalReturn  Float
  features     Json         @default("[]")
  popular      Boolean      @default(false)
  active       Boolean      @default(true)
  icon         String       @default("TrendingUp")
  color        String       @default("#F4B400")
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  investments  Investment[]
}

model Investment {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          InvestmentPlan   @relation(fields: [planId], references: [id])
  amount        Float
  dailyReturn   Float
  durationDays  Int
  totalReturn   Float
  status        InvestmentStatus @default(ACTIVE)
  profitEarned  Float            @default(0)
  startDate     DateTime         @default(now())
  endDate       DateTime
  lastAccruedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([status])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  Currency
  address   String
  label     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
}

model DepositRequest {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Float
  currency   Currency          @default(USDT_TRC20)
  txHash     String?
  network    String?
  status     TransactionStatus @default(PENDING)
  note       String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
  @@index([status])
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  reference         String          @unique
  providerReference String?         @unique
  amount            Float
  currency          String
  exchangeRate      Float
  creditedAmount    Float
  phone             String?
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([provider, status])
}

model Withdrawal {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Float
  fee        Float            @default(0)
  currency   Currency         @default(USDT_TRC20)
  address    String
  status     WithdrawalStatus @default(PENDING)
  note       String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

model Transaction {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TransactionType
  amount       Float
  fee          Float             @default(0)
  status       TransactionStatus @default(COMPLETED)
  description  String
  reference    String            @unique
  currency     Currency          @default(USDT_TRC20)
  balanceAfter Float?
  metadata     Json?
  createdAt    DateTime          @default(now())

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  priority  TicketPriority  @default(MEDIUM)
  status    TicketStatus    @default(OPEN)
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderRole Role
  message    String
  createdAt  DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  link      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Ipo {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  issuer          String
  ticker          String?
  exchange        String?
  logoUrl         String?
  tagline         String
  overview        String
  keyFacts        Json             @default("[]")
  riskDisclaimers String           @default("Investing in an initial public offering involves significant risk. Prices may fall as well as rise and past performance is not a guide to future returns. This page does not constitute an offer or investment advice and no returns or allocations are guaranteed.")
  pricePerShare   Float
  totalShares     Float
  minimumShares   Int              @default(10)
  maximumShares   Int?
  greenshoePct    Float            @default(0)
  feePct          Float            @default(0)
  currency        String           @default("NGN")
  openDate        DateTime?
  closeDate       DateTime?
  allotmentDate   DateTime?
  listingDate     DateTime?
  status          IpoStatus        @default(DRAFT)
  published       Boolean          @default(false)
  sandbox         Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  applications    IpoApplication[]
  documents       IpoDocument[]
  refunds         IpoRefund[]

  @@index([status])
  @@index([published])
}

model IpoApplication {
  id                 String               @id @default(cuid())
  ipoId              String
  ipo                Ipo                  @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  userId             String
  user               User                 @relation("IpoApplications", fields: [userId], references: [id], onDelete: Cascade)
  reference          String               @unique
  shares             Int
  pricePerShare      Float
  amountNgn          Float
  feeNgn             Float                @default(0)
  exchangeRate       Float
  amountUsd          Float
  status             IpoApplicationStatus @default(SUBMITTED)
  sandbox            Boolean              @default(false)
  allocationShares   Int?
  allocationRate     Float?
  allocatedAmountNgn Float?
  transactionRef     String?
  submittedAt        DateTime             @default(now())
  paidAt             DateTime?
  allocatedAt        DateTime?
  refundedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  refund             IpoRefund?

  @@unique([userId, ipoId])
  @@index([ipoId, status])
  @@index([userId])
}

model IpoInvestorProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  dob              String?
  gender           String?
  nationality      String
  residencyCountry String
  city             String?
  address          String?
  bvnCipher        String?
  bvnLast4         String?
  bankName         String
  accountName      String?
  accountCipher    String?
  cscsChn          String?
  idType           String?
  idCipher         String?
  idDocumentUrl    String?
  status           KycStatus @default(NOT_SUBMITTED)
  adminNote        String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

model IpoDocument {
  id          String          @id @default(cuid())
  ipoId       String
  ipo         Ipo             @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  title       String
  type        IpoDocumentType @default(UPLOAD)
  url         String
  description String?
  published   Boolean         @default(true)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([ipoId])
}

model IpoRefund {
  id            String          @id @default(cuid())
  applicationId String          @unique
  application   IpoApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ipoId         String
  ipo           Ipo             @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation("IpoRefunds", fields: [userId], references: [id], onDelete: Cascade)
  reference     String          @unique
  amountNgn     Float
  amountUsd     Float
  exchangeRate  Float
  reason        String
  status        IpoRefundStatus @default(PENDING)
  note          String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([ipoId, status])
  @@index([userId])
}

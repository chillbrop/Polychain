# Polychain Capital environment configuration
# Copy to .env and fill in values

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novavest"

# --- Server ---
PORT=4000
NODE_ENV=development
JWT_SECRET="change-this-to-a-long-random-string"
JWT_REFRESH_SECRET="change-this-to-another-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE=false

# --- Frontend ---
# Leave empty to call the API same-origin through the Next.js /api rewrite proxy
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Polychain Capital"

# --- Mail (SMTP) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Polychain Capital <no-reply@polychaincapital.example>"

# --- Admin bootstrap ---
ADMIN_EMAIL="admin@polychaincapital.example"
ADMIN_PASSWORD="Admin@12345"

# --- Wallet ---
USDT_TRC20_ADDRESS="TXXXXXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BTC_ADDRESS="bc1qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ETH_ADDRESS="0xXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# --- Payments ---
# Rates are native currency units per 1 USD wallet credit (for example, 1600 NGN per USD).
PAYSTACK_SECRET_KEY="sk_test_ef2cf281d8f2c78f36a9ed136dae9f7b31b7fba1"
PAYSTACK_CURRENCY="NGN"
PAYSTACK_USD_RATE="0"

# Use Daraja sandbox credentials while testing. MPESA_CALLBACK_URL must be publicly reachable by Safaricom.
# MPESA_SHORT_CODE is the Paybill (business) number; MPESA_ACCOUNT_REFERENCE is the account number shown on the customer's phone.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORT_CODE="247247"
MPESA_ACCOUNT_REFERENCE="0795911898"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://api.example.com/api/payments/mpesa/callback"
MPESA_BASE_URL="https://sandbox.safaricom.co.ke"
MPESA_USD_RATE="0"
